NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only demo credential shown on the login page for the bounty judge.
# Configure both values together. Do not prefix them with NEXT_PUBLIC_.
DEMO_LOGIN_EMAIL=admin@stokledger.demo
DEMO_LOGIN_PASSWORD=replace-with-demo-password

# Server-only. Do not prefix this value with NEXT_PUBLIC_.
# Only needed by explicit seed/maintenance tooling, never by the browser app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# E2E-only Admin credential. Keep these values server-side and local.
E2E_ADMIN_EMAIL=admin@stokledger.demo
E2E_ADMIN_PASSWORD=replace-with-e2e-password

# Mutating E2E is skipped unless this is exactly `demo` and the target is localhost.
E2E_MUTATION_MODE=off
PLAYWRIGHT_BASE_URL=http://localhost:3000
